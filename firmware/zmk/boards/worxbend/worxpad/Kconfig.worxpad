# SPDX-License-Identifier: MIT
# BMD-340 carries an nRF52840-QIAA. ZMK_BOARD_COMPAT and the retention options give the &bootloader
# behaviour its double-reset entry into the Adafruit UF2 bootloader (as ZMK's nice_nano board does).

config BOARD_WORXPAD
    select SOC_NRF52840_QIAA
    select ZMK_BOARD_COMPAT
    imply RETAINED_MEM
    imply RETENTION
    imply RETENTION_BOOT_MODE
