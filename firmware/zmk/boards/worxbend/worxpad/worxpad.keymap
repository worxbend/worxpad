/*
 * SPDX-License-Identifier: MIT
 *
 * worxpad default keymap. docs/keymap.md describes it. Ctrl shortcuts as Windows and Linux creative
 * applications use them; on macOS remap Ctrl to Cmd in ZMK Studio or in the host.
 *
 * Position order per layer (worxpad_nrf52840_zmk.dts, matrix_transform):
 *   4 x 4 keys row by row from the rear-left, then left knob push, right knob push, left button,
 *   right button. Sensor bindings: left knob, right knob; the first key is clockwise.
 *
 * The right button steps Edit -> Nav -> Media -> Edit. Holding the left button gives System:
 * layer select, Bluetooth profiles, output, ZMK Studio unlock, reset and bootloader.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define EDIT 0
#define NAV 1
#define MEDIA 2
#define SYS 3

/ {
    keymap {
        compatible = "zmk,keymap";

        edit {
            display-name = "Edit";
            bindings = <
                &kp ESC        &kp LC(Z)    &kp LC(LS(Z))  &kp LC(LS(S))
                &kp LC(X)      &kp LC(C)    &kp LC(V)      &kp DEL
                &kp LSHFT      &kp LCTRL    &kp LALT       &kp SPACE
                &kp LC(A)      &kp LC(F)    &kp TAB        &kp ENTER
                &kp LC(S)      &kp LC(N0)   &mo SYS        &to NAV
            >;
            sensor-bindings = <&inc_dec_kp LC(LS(Z)) LC(Z) &inc_dec_kp LC(EQUAL) LC(MINUS)>;
        };

        nav {
            display-name = "Nav";
            bindings = <
                &kp HOME       &kp UP       &kp END        &kp PG_UP
                &kp LEFT       &kp DOWN     &kp RIGHT      &kp PG_DN
                &kp LSHFT      &kp LCTRL    &kp LALT       &kp TAB
                &kp BSPC       &kp LC(LS(TAB)) &kp LC(TAB) &kp ENTER
                &kp SPACE      &kp ENTER    &mo SYS        &to MEDIA
            >;
            sensor-bindings = <&inc_dec_kp RIGHT LEFT &inc_dec_kp DOWN UP>;
        };

        media {
            display-name = "Media";
            bindings = <
                &kp C_PREV     &kp C_PP     &kp C_NEXT     &kp C_MUTE
                &kp C_VOL_DN   &kp C_VOL_UP &kp C_BRI_DN   &kp C_BRI_UP
                &kp F13        &kp F14      &kp F15        &kp F16
                &kp F17        &kp F18      &kp F19        &kp F20
                &kp C_MUTE     &kp C_PP     &mo SYS        &to EDIT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        /* No sensor bindings: the knobs keep the function of the layer below. */
        sys {
            display-name = "System";
            bindings = <
                &to EDIT       &to NAV      &to MEDIA      &studio_unlock
                &bt BT_SEL 0   &bt BT_SEL 1 &bt BT_SEL 2   &bt BT_SEL 3
                &bt BT_PRV     &bt BT_NXT   &bt BT_CLR     &out OUT_TOG
                &out OUT_USB   &out OUT_BLE &sys_reset     &bootloader
                &trans         &trans       &trans         &trans
            >;
        };
    };
};
